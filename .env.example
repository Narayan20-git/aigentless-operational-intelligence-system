SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
GOOGLE_API_KEY=
# ─────────────────────────────────────────────────────────────────────────────
# OpenAI API Key  (used by Google ADK via LiteLlm)
# Get from: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_key_here
# Optional: defaults to gpt-4o-mini (Lesa AI brief + any direct OpenAI calls)
# OPENAI_MODEL=gpt-4o-mini
# Lesa AI /briefs/weekly: smaller JSON + shorter generations = faster responses
# LESA_AI_MAX_TOKENS=2200
# LESA_AI_TIMEOUT_SEC=40